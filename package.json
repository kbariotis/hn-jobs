{
  "name": "hn-jobs",
  "private": true,
  "description": "Natural-language search over Hacker News \"Who is hiring?\" threads",
  "scripts": {
    "extract": "ts-node ops/extract.ts",
    "db:up": "docker compose up -d --wait db",
    "migrate": "ts-node ops/migrate.ts",
    "vercel-build": "ts-node ops/migrate.ts --deploy",
    "index": "ts-node ops/indexing.ts",
    "import-extractions": "ts-node ops/import-extractions.ts",
    "daily": "ts-node ops/daily.ts",
    "serve": "ts-node ops/serve.ts",
    "eval:retrieval": "ts-node ops/eval-retrieval.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test \"lib/**/*.test.ts\"",
    "seed-gold": "ts-node ops/seed-gold.ts",
    "eval:extract": "ts-node ops/eval-extract.ts",
    "eval:check": "ts-node ops/eval-extract.ts --check",
    "review": "ts-node ops/review-server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Kostas Bariotis <kostas@bariotis.com>",
  "dependencies": {
    "@langchain/core": "^1.1.3",
    "@langchain/google-genai": "2.0.4",
    "@langchain/ollama": "^1.0.3",
    "@upstash/ratelimit": "^2.2.3",
    "@upstash/redis": "^1.41.1",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "langchain": "^1.1.4",
    "pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript-eslint": "8.74.0"
  }
}
