{
  "name": "hn-jobs",
  "private": true,
  "description": "Chat assistant for Hacker News jobs",
  "scripts": {
    "start": "ts-node",
    "extract": "ts-node ops/extract.ts",
    "index": "ts-node ops/indexing.ts",
    "relevance": "ts-node ops/relevance.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test tests/*.test.ts",
    "seed-gold": "ts-node ops/seed-gold.ts",
    "eval:extract": "ts-node ops/eval-extract.ts",
    "eval:check": "ts-node ops/eval-extract.ts --check",
    "review": "ts-node ops/review-server.ts"
  },
  "author": "Kostas Bariotis <kostas@bariotis.com>",
  "dependencies": {
    "@huggingface/inference": "^4.13.4",
    "@langchain/community": "^1.0.7",
    "@langchain/core": "^1.1.3",
    "@langchain/google-genai": "2.0.4",
    "@langchain/mcp-adapters": "^1.0.3",
    "@langchain/ollama": "^1.0.3",
    "cheerio": "^1.1.2",
    "chromadb": "^3.1.7",
    "dotenv": "^17.2.3",
    "langchain": "^1.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@browserbasehq/stagehand": {
      "dotenv": "$dotenv"
    }
  }
}
