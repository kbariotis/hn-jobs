# Local dev database (docker compose). Pick any local-only password; never reuse a real one.
POSTGRES_PASSWORD="<local-dev-password>"
DATABASE_URL="postgres://hnjobs:<local-dev-password>@127.0.0.1:5433/hnjobs"
# "<provider>:<model>" — e.g. ollama:qwen3:8b, google-genai:gemini-3.5-flash (needs GOOGLE_API_KEY)
EXTRACT_MODEL="google-genai:gemini-3.5-flash"
# "<provider>:<model>" — google-genai:gemini-embedding-001 or ollama:qwen3-embedding:0.6b
EMBED_MODEL="google-genai:gemini-embedding-001"
THREAD_ID="46108941"
